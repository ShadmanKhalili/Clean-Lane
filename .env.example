# Firebase (live pitch demo). Without these, the live demo runs in offline-backup
# mode (tabs on one device + simulated audience). Web config values are not
# secrets — access is controlled by database.rules.json. See docs/FIREBASE_SETUP.md.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Optional: point the SDK at the local emulator, e.g. "127.0.0.1:9000".
# VITE_FIREBASE_EMULATOR_HOST=""
